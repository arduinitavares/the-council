    {
      "id": "recovery",
      "title": "Global cancellation and recovery",
      "kind": "flowchart",
      "description": "This view summarizes transitions that apply to every active phase. It does not introduce another model role.",
      "data": {
        "direction": "TB",
        "nodes": [
          {
            "id": "active",
            "label": "Any active phase",
            "class": "coord"
          },
          {
            "id": "settling",
            "label": "settling / stop owned work",
            "class": "coord"
          },
          {
            "id": "reconciling",
            "label": "reconciling / inspect ownership",
            "class": "store"
          },
          {
            "id": "live",
            "label": "Same attempt proved live",
            "class": "reviewer"
          },
          {
            "id": "unknown",
            "label": "Unknown / keep state unknown",
            "class": "judge"
          },
          {
            "id": "exit",
            "label": "Exit proved / safe cleanup",
            "class": "reviewer"
          },
          {
            "id": "outcome",
            "label": "Publish recorded outcome",
            "class": "store"
          },
          {
            "id": "restore",
            "label": "Restart / persisted checkpoint",
            "class": "store"
          }
        ],
        "edges": [
          {
            "from": "active",
            "to": "settling",
            "label": "error, cancellation, or deadline"
          },
          {
            "from": "settling",
            "to": "reconciling",
            "label": "missing exit proof"
          },
          {
            "from": "restore",
            "to": "reconciling",
            "label": "no blind re-launch"
          },
          {
            "from": "reconciling",
            "to": "live",
            "label": "positive liveness"
          },
          {
            "from": "live",
            "to": "active",
            "label": "reconnect; preserve attempt"
          },
          {
            "from": "reconciling",
            "to": "unknown",
            "label": "insufficient evidence"
          },
          {
            "from": "unknown",
            "to": "reconciling",
            "label": "observe again"
          },
          {
            "from": "reconciling",
            "to": "exit",
            "label": "positive exit evidence"
          },
          {
            "from": "exit",
            "to": "settling",
            "label": "settle and release"
          },
          {
            "from": "settling",
            "to": "outcome",
            "label": "all owned resources settled"
          }
        ]
      },
