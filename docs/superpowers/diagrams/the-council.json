        {
          "name": "coord",
          "definition": "fill:#e8f1ff,stroke:#285b9a,color:#172f52"
        },
        {
          "name": "store",
          "definition": "fill:#f2f4f7,stroke:#667085,color:#273142"
        },
        {
          "name": "reviewer",
          "definition": "fill:#eaf7ef,stroke:#35724c,color:#194a2b"
        },
        {
          "name": "judge",
          "definition": "fill:#fff2db,stroke:#9a6a17,color:#664300"
        }
      ]
    },
    {
      "id": "states",
      "title": "Council control states",
      "kind": "state",
      "description": "New runs start at preflight. Restored runs enter reconciling. Every decision outcome requires resource settlement.",
      "accessibility": "The workflow collects three reviews, freezes a candidate, obtains a fresh judge report, and collects three final responses. Unanimous acceptance completes the run. The third unresolved round returns to the user.",
      "data": {
        "initial": "preflight",
        "states": [
          {
            "id": "preflight",
            "label": "preflight"
          },
          {
            "id": "needs_context",
            "label": "needs_context"
          },
          {
            "id": "prepare_round",
            "label": "prepare_round"
          },
          {
            "id": "reviewing",
            "label": "reviewing"
          },
          {
            "id": "prepare_candidate",
            "label": "prepare_candidate"
          },
          {
            "id": "judging",
            "label": "judging"
          },
          {
            "id": "confirming",
            "label": "confirming"
          },
          {
            "id": "evaluate_round",
            "label": "evaluate_round"
          },
          {
            "id": "settling",
            "label": "settling"
          },
          {
            "id": "completed",
            "label": "completed"
          },
          {
            "id": "needs_user",
            "label": "needs_user"
          },
          {
            "id": "blocked",
            "label": "blocked"
          },
          {
            "id": "cancelled",
            "label": "cancelled"
          },
          {
            "id": "reconciling",
            "label": "reconciling"
          }
        ],
        "transitions": [
          {
            "from": "preflight",
            "to": "needs_context",
            "label": "missing input"
          },
          {
            "from": "needs_context",
            "to": "preflight",
            "label": "context supplied"
          },
          {
            "from": "preflight",
            "to": "blocked",
            "label": "policy or route gap"
          },
          {
            "from": "preflight",
            "to": "prepare_round",
            "label": "checks pass"
          },
          {
            "from": "prepare_round",
            "to": "reviewing",
            "label": "admit round and launch three"
          },
          {
            "from": "reviewing",
            "to": "prepare_candidate",
            "label": "three reviews settled"
          },
          {
            "from": "reviewing",
            "to": "settling",
            "label": "same missing input / needs_user"
          },
          {
            "from": "prepare_candidate",
            "to": "judging",
            "label": "candidate frozen"
          },
          {
            "from": "judging",
            "to": "confirming",
            "label": "judge report and exit verified"
          },
          {
            "from": "confirming",
            "to": "evaluate_round",
            "label": "three final responses settled"
          },
          {
            "from": "evaluate_round",
            "to": "prepare_round",
            "label": "disagreement and rounds remain"
          },
          {
            "from": "evaluate_round",
            "to": "settling",
            "label": "unanimous or round limit"
          },
          {
            "from": "settling",
            "to": "completed",
            "label": "consensus; all resources settled"
          },
          {
            "from": "settling",
            "to": "needs_user",
            "label": "unresolved; all resources settled"
          },
          {
            "from": "settling",
            "to": "blocked",
            "label": "operational gap; settled"
          },
          {
            "from": "settling",
            "to": "cancelled",
            "label": "cancel requested; settled"
          },
          {
            "from": "settling",
            "to": "reconciling",
            "label": "lifecycle unknown"
          },
          {
            "from": "reconciling",
            "to": "settling",
            "label": "exit and ownership established"
          },
          {
            "from": "needs_user",
            "to": "preflight",
            "label": "new input and rounds authorized"
          },
          {
            "from": "blocked",
            "to": "preflight",
            "label": "specific remedy authorized"
          }
        ]
      }
