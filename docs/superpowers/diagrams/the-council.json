{
  "version": 2,
  "title": "The Council: nodes and states",
  "description": "Implementation planning diagrams for the approved Council design. They show proposed software, not a deployed system.",
  "diagrams": [
    {
      "id": "components",
      "title": "Council component nodes",
      "kind": "flowchart",
      "description": "The calling agent authors candidates. The state machine selects transitions. Orca owns worker lifecycle.",
      "accessibility": "Three equal reviewers and one fresh judge connect through an Orca adapter to a deterministic controller and its journal.",
      "data": {
        "direction": "TB",
        "nodes": [
          {
            "id": "caller",
            "label": "Calling agent / candidate author",
            "class": "coord"
          },
          {
            "id": "skill",
            "label": "Council skill / supervised loop",
            "class": "coord"
          },
          {
            "id": "core",
            "label": "XState core / pure transitions",
            "class": "coord"
          },
          {
            "id": "journal",
            "label": "SQLite / events and effect intents",
            "class": "store"
          },
          {
            "id": "evidence",
            "label": "Evidence adapter / allowed checks",
            "class": "store"
          },
          {
            "id": "orca",
            "label": "Orca adapter / lifecycle receipts",
            "class": "coord"
          },
          {
            "id": "astra",
            "label": "Astra reviewer / Ultra",
            "class": "reviewer"
          },
          {
            "id": "argon",
            "label": "Argon reviewer / High",
            "class": "reviewer"
          },
          {
            "id": "opus",
            "label": "Opus reviewer / High",
            "class": "reviewer"
          },
          {
            "id": "judge",
            "label": "Fresh Astra judge / Ultra",
            "class": "judge"
          }
        ],
        "edges": [
          {
            "from": "caller",
            "to": "skill",
            "label": "input and candidate"
          },
          {
            "from": "skill",
            "to": "core",
            "label": "validated events"
          },
          {
            "from": "core",
            "to": "journal",
            "label": "atomic checkpoint and intents"
          },
          {
            "from": "core",
            "to": "evidence",
            "label": "allowed evidence requests"
          },
          {
            "from": "core",
            "to": "orca",
            "label": "launch or reconcile intents"
          },
          {
            "from": "orca",
            "to": "astra",
            "label": "reviewer phase"
          },
          {
            "from": "orca",
            "to": "argon",
            "label": "reviewer phase"
          },
          {
            "from": "orca",
            "to": "opus",
            "label": "reviewer phase"
          },
          {
            "from": "orca",
            "to": "judge",
            "label": "between reviewer phases"
          },
          {
            "from": "orca",
            "to": "core",
            "label": "validated results"
          },
          {
            "from": "core",
            "to": "caller",
            "label": "action request or final report"
          }
        ]
      },
